{
  "name": "Cross-Device: Remote Sensor Data Relay",
  "description": "Every 60 seconds, query environmental sensor data (temperature, humidity, CO2) from a remote Axis camera and publish it over MQTT with decimal formatting. Demonstrates the remote vapix_query action and the |N format specifier.",
  "enabled": true,
  "trigger_logic": "OR",
  "trigger_window": 0,
  "condition_logic": "AND",
  "cooldown": 0,
  "max_executions": 0,
  "max_exec_period": "",
  "triggers": [
    {
      "type": "schedule",
      "schedule_type": "interval",
      "interval_seconds": 60
    }
  ],
  "conditions": [],
  "actions": [
    {
      "type": "vapix_query",
      "topic0": { "tns1": "Environment" },
      "topic1": { "tnsaxis": "AirQuality" },
      "remote_host": "192.168.1.50",
      "remote_user": "root",
      "remote_pass": "pass"
    },
    {
      "type": "mqtt_publish",
      "topic": "sensors/{{camera.serial}}/environment",
      "payload": "{\"temperature\":{{trigger.Temperature|2}},\"humidity\":{{trigger.Humidity|1}},\"co2\":{{trigger.CO2|0}},\"source\":\"{{camera.serial}}\",\"timestamp\":\"{{timestamp}}\"}",
      "qos": 1,
      "retain": true
    }
  ]
}
