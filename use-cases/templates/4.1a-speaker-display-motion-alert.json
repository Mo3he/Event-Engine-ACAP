{
  "name": "Speaker Display — Motion Alert (while active)",
  "description": "When motion is detected, show an alert message on the Axis speaker-display screen. The message stays on screen automatically while motion continues and is cleared as soon as motion stops — no fixed duration needed.",
  "enabled": true,
  "trigger_logic": "OR",
  "trigger_window": 0,
  "condition_logic": "AND",
  "cooldown": 5,
  "max_executions": 0,
  "max_exec_period": "",
  "triggers": [
    {
      "type": "vapix_event",
      "topic0": { "tns1": "RuleEngine" },
      "topic1": { "tnsaxis": "MotionDetection" },
      "filter_key": "active",
      "filter_value": true
    }
  ],
  "conditions": [],
  "actions": [
    {
      "type": "speaker_display",
      "operation": "show",
      "message": "⚠ Motion Detected — {{camera.name}}\n{{date}} {{time}}",
      "textColor": "#FFFFFF",
      "backgroundColor": "#CC0000",
      "textSize": "large",
      "scrollDirection": "",
      "scrollSpeed": 0,
      "while_active": true
    }
  ]
}
